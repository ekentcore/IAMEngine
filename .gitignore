# --- secrets / env (NEVER commit) ---
env.env
.env
.env.local
*.env
!*.env.example
web/.env
web/.env.local

# --- dependencies ---
node_modules/
# no trailing slash: also matches the node_modules SYMLINK a worktree uses (a
# trailing-slash pattern only matches real directories, so the link slips into commits)
web/node_modules

# --- build output ---
.next/
web/.next/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# --- prisma generated client ---
web/node_modules/.prisma/

# --- os / editor ---
.DS_Store
*.log

# --- playwright MCP scratch (screenshots/console logs from in-session browser checks) ---
.playwright-mcp/
*.png

# --- archives ---
*.zip

# --- client KB corpus (sensitive: keep local, Phase-6 generator input only) ---
data/

# --- generated client profiles (real names/domains: keep local, reproduce via npm run generate:profiles) ---
web/profiles/generated/
profiles/generated/

# editor swap files
*.swp
*.swo
*~

# --- python (profile-generator extract stage) ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# --- profile-generator output (regenerable via run.sh; promote good drafts into profiles/) ---
tools/profile-generator/out/
profiles/_drafts/

# claude worktrees
.claude/worktrees/

# playwright e2e
test-results/
playwright-report/
web/test-results/
web/playwright-report/

# Local certificates / private keys (e.g. Exchange Online app-only auth) — NEVER commit
exo.cer
exo.key
exo.pfx
*.pfx
*.key

# tooling/runtime artifacts that must never ship in the runner bundle
runner/.claude/
runner/.remember/

# spanning login-test scratch (screenshots, network capture, browser profile)
runner/browser/scripts/.spanning-test-run/
runner/browser/scripts/.spanning-profile/

# Delinea credential-recovery artifacts (client->secret-id map; not for git)
delinea-cred-recovery-report.csv
delinea-cred-recovery-rollback.sql
rollback-pre-apply.*

# Local Claude project configuration
.claude/

# machine-specific node_modules symlink some tooling drops here — never track it
runner/browser/node_modules
