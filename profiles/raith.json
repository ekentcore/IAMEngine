{
  "schemaVersion": "1.0",

  "client": {
    "id": "raith",
    "name": "Raith Capital Partners, LLC",
    "primaryDomain": "raithcapital.com",
    "pod": "POD-FinancialServices"
  },

  "kb": {
    "onboard":  { "number": "KB0035920", "sections": ["ServiceNow", "Microsoft 365", "Mimecast", "Egnyte", "Adobe", "Address Book", "Case Resolution"] },
    "offboard": { "number": "KB0035921", "sections": ["ServiceNow", "Microsoft 365", "Egnyte", "Adobe", "LOB", "Case Resolution"] }
  },

  "identity": {
    "usernamePattern": "{first}.{last}@{domain}",
    "displayNamePattern": "{first} {last}"
  },

  "password": {
    "minLength": 16,
    "requireUpper": true,
    "requireLower": true,
    "requireNumber": true,
    "requireSpecial": true,
    "requireChangeAtSignIn": true
  },

  "delivery": {
    "method": "mimecast-secure-email",
    "note": "Send initial credentials via Mimecast secure message; force change at first sign-in."
  },

  "secrets": {
    "m365-admin":          { "provider": "delinea", "id": "20102", "label": "M365 Admin Center" },
    "mimecast-admin":      { "provider": "delinea", "id": "54760", "label": "Mimecast Admin Console" },
    "egnyte-portal":       { "provider": "delinea", "id": "20117", "label": "Egnyte portal (raithcapital.egnyte.com)" },
    "ess-host":            { "provider": "delinea", "id": "51495", "label": "rcp-lmc-01 host login" },
    "ess-app":             { "provider": "delinea", "id": "20123", "label": "Egnyte Sync Server appliance login" },
    "adobe-admin":         { "provider": "delinea", "id": "REPLACE_ME", "label": "Adobe Admin Console (secret id not in KB)" }
  },

  "systems": [
    {
      "key": "servicenow-contact",
      "mode": "api",
      "enabled": true,
      "dependsOn": [],
      "config": {
        "convertNonUmCases": true,
        "requiredFields": ["email", "phone", "location", "title"]
      }
    },
    {
      "key": "m365",
      "mode": "api",
      "enabled": true,
      "secret": "m365-admin",
      "dependsOn": ["servicenow-contact"],
      "config": {
        "defaultLicenses": [
          { "name": "Microsoft 365 E3",            "skuId": "05e9a617-0261-4cee-bb44-138d3ef5d965" },
          { "name": "Microsoft 365 Audio Conferencing", "skuId": "0c266dff-15dd-4b49-8397-2bb16070ed52" },
          { "name": "Microsoft 365 E5 Compliance", "skuId": "184efa21-98c3-4e5d-95ab-d07053a96e67" }
        ],
        "skuNote": "Verify GUIDs against the tenant with Get-MgSubscribedSku; E5 is requested by POC when needed.",
        "defaultGroups": ["all@raithcapital.com"],
        "alias": { "enabled": false }
      }
    },
    {
      "key": "mimecast",
      "mode": "api",
      "enabled": true,
      "secret": "mimecast-admin",
      "dependsOn": ["m365"],
      "config": {
        "triggerDirectorySync": true,
        "verifyInInternalDirectory": true,
        "syncTimeoutSeconds": 300
      }
    },
    {
      "key": "egnyte",
      "mode": "api",
      "enabled": true,
      "secret": "egnyte-portal",
      "dependsOn": ["m365"],
      "config": {
        "portal": "raithcapital.egnyte.com",
        "userType": "power",
        "authType": "sso",
        "groups": ["AllUsers"]
      }
    },
    {
      "key": "egnyte-sync-server",
      "mode": "browser",
      "enabled": true,
      "secret": "ess-app",
      "dependsOn": ["egnyte"],
      "config": {
        "host": "rcp-lmc-01",
        "applianceUrl": "https://263fzlk8qv.egnyte-appliance.com/login",
        "steps": [
          "User Settings > User Filtering > Add User Account (random password, unused)",
          "User Settings > User Mapping > Actions > Refresh and Auto Map Users"
        ]
      }
    },
    {
      "key": "adobe",
      "mode": "api",
      "enabled": true,
      "secret": "adobe-admin",
      "dependsOn": ["m365"],
      "config": {
        "defaultProductProfile": "Default Acrobat Pro DC",
        "note": "POC approves any license upticks."
      }
    },
    {
      "key": "address-book",
      "mode": "manual",
      "enabled": true,
      "secret": "ess-host",
      "dependsOn": [],
      "config": {
        "host": "rcp-lmc-01",
        "printerConfigUrl": "https://coretelligent.itglue.com/5919710/configurations/43379025",
        "steps": ["Open printer admin in a browser", "Add the user to the address book"]
      }
    },
    {
      "key": "case-resolution",
      "mode": "api",
      "enabled": true,
      "dependsOn": ["m365", "mimecast", "egnyte", "adobe"],
      "config": {
        "windowsSetupIfComputerRequested": true,
        "sendCredentials": true,
        "closeAllTasks": true
      }
    }
  ]
}
