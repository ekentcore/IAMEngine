  "systems": [
    {
      "key": "servicenow",
      "mode": "api",
      "dependsOn": [],
      "onboard": { "when": "always", "config": { "requiredFields": ["email", "title", "manager", "location", "role", "startDate"] } },
      "offboard": { "when": "always", "config": { "action": "mark-inactive-on-end-date" } }
    },
    {
      "key": "active-directory",
      "mode": "api",
      "secrets": ["ad-dc"],
      "dependsOn": ["servicenow"],
      "onboard": { "when": "always", "config": { "enabled": true } },
      "offboard": {
        "when": "always",
        "captureEvidence": true,
        "guardrails": ["do-not-move-ou"],
        "dependsOn": ["exchange"],
        "config": {
          "disable": true,
          "disableAccount": true,
          "resetPassword": true,
          "adminAccountSuffix": "-a",
          "hideFromGAL": true,
          "removeGroups": true,
          "removeAllGroups": true,
          "disabledUsersPrimaryGroup": "Disabled Users",
          "disabledUsersOu": "OU=Disabled Users,OU=Users,OU=Coretelligent,DC=coretelligent,DC=local",
          "disableComputer": true,
          "disabledComputersOu": "OU=Disabled,OU=Computers,OU=Coretelligent,DC=coretelligent,DC=local"
        }
      }
    },
    {
      "key": "exchange",
      "mode": "api",
      "secrets": ["exchange-onprem", "m365-admin"],
      "dependsOn": ["active-directory"],
      "onboard": {
        "when": "always",
        "config": {
          "onPremExchangeUri": "http://core-cce1-ex01.coretelligent.local/PowerShell/",
          "enableRemoteMailbox": { "routingDomain": "coretell.mail.onmicrosoft.com", "emailAddressPolicyEnabled": true },
          "regional": { "language": "en-us", "timezone": "{location.timezone}", "defaultTimezone": "Eastern Standard Time" },
          "calendar": { "grantManagerReviewer": true }
        }
      },
      "offboard": {
        "when": "always",
        "captureEvidence": true,
        "dependsOn": [],
        "config": {
          "convertToShared": { "skipIfMailboxOverGB": 50 },
          "delegateManagerFullAccess": true,
          "blockMobileDevices": true,
          "adminAccountSuffix": "-a",
          "onPremExchangeUri": "http://core-cce1-ex01.coretelligent.local/PowerShell/"
        }
      }
    },
    {
      "key": "directory-sync",
      "mode": "api",
      "secrets": ["ad-dc"],
      "dependsOn": ["exchange"],
      "onboard": { "when": "always", "config": { "command": "Start-ADSyncSyncCycle -PolicyType Delta", "waitForMailbox": true } },
      "offboard": { "when": "always", "dependsOn": ["exchange", "active-directory"], "config": { "command": "Start-ADSyncSyncCycle -PolicyType Delta", "host": "CORE-CCE-AZSYNC.coretelligent.local" } }
    },
    {
      "key": "m365",
      "mode": "api",
      "secrets": ["m365-admin"],
      "dependsOn": ["directory-sync"],
      "onboard": { "when": "always", "config": {} },
      "offboard": { "when": "always", "dependsOn": ["exchange"], "config": { "blockSignIn": true, "removeLicense": {}, "mailbox": { "sizeThresholdGB": 50 } } }
    },
    {
      "key": "tap",
      "mode": "api",
      "secrets": ["m365-admin"],
      "dependsOn": ["m365"],
      "onboard": { "when": "always", "config": {} },
      "offboard": { "when": "never" }
    },
    {
      "key": "case-resolution",
      "mode": "manual",
      "dependsOn": ["m365"],
      "onboard": { "when": "always", "config": {} },
      "offboard": { "when": "always", "config": {} }
    },
    {
      "key": "entra",
      "mode": "api",
      "secrets": ["m365-admin"],
      "dependsOn": [],
      "onboard": { "when": "never" },
      "offboard": {
        "when": "always",
        "captureEvidence": true,
        "dependsOn": ["exchange"],
        "config": { "blockSignIn": true, "revokeSessions": true, "disableDevices": true, "captureDevices": true, "removeAllGroups": true, "adminAccountSuffix": "-a" }
      }
    },
    {
      "key": "sentinelone",
      "mode": "api",
      "secrets": ["sentinelone"],
      "dependsOn": [],
      "onboard": { "when": "never" },
      "offboard": { "when": "always", "requiresApproval": true, "dependsOn": ["entra"], "config": { "shutdown": false } }
    },
    {
      "key": "zoom",
      "mode": "api",
      "secrets": ["zoom"],
      "dependsOn": [],
      "onboard": { "when": "never" },
      "offboard": { "when": "always", "dependsOn": ["exchange"], "config": { "revokeSso": true } }
    },
    {
      "key": "duo",
      "mode": "api",
      "secrets": ["duo"],
      "dependsOn": [],
      "onboard": { "when": "never" },
      "offboard": { "when": "always", "dependsOn": ["m365"], "config": {} }
    },
    {
      "key": "xmatters",
      "mode": "api",
      "secrets": ["xmatters"],
      "dependsOn": [],
      "onboard": { "when": "never" },
      "offboard": { "when": "always", "dependsOn": ["m365"], "config": {} }
    },
    {
      "key": "logicmonitor",
      "mode": "api",
      "secrets": ["logicmonitor"],
      "dependsOn": [],
      "onboard": { "when": "never" },
      "offboard": { "when": "always", "dependsOn": ["m365"], "config": {} }
    },
    {
      "key": "notify",
      "mode": "api",
      "secrets": ["m365-admin"],
      "dependsOn": [],
      "runLast": true,
      "onboard": { "when": "never" },
      "offboard": {
        "when": "always",
        "dependsOn": [],
        "config": {
          "sender": "ekent@core.tech",
          "recipients": [
            "scott.camara@coretelligent.com", "todd.oblak@coretelligent.com", "evan.kent@coretelligent.com",
            "joe.aukofer@coretelligent.com", "miguel.gallegos@coretelligent.com", "anthony.bostock@coretelligent.com",
            "erik.truax@coretelligent.com", "jennifer.hughes@coretelligent.com", "justin.mascio@coretelligent.com"
          ],
          "caseNoteAddress": "internalsupport@core.tech"
        }
      }
    }
  ],

  "runbook": {
    "onboard": "Active Directory\n- Create the user in the role + location OU (e.g. OU=CA,OU=Field Services,OU=Users,OU=Coretelligent,DC=coretelligent,DC=local).\n- Set directory attributes from the case: title, department, manager, company, c / co / countryCode, employeeType, extensionAttribute4 (start date), ipPhone (DID extension), physicalDeliveryOfficeName.\n- Add to the global groups (Egnyte-CS-CORE, Centrify - Egnyte Power Users, RDS-Users, VPN-Split, Core-ALL, ...) plus the selected persona's role groups.\n- If the request says \"mirror <user>\", union that reference user's live group memberships.\n- Map the home drive if the persona configures one.\n\nEntra Connect sync\n- Trigger an Azure AD Connect delta sync (Start-ADSyncSyncCycle) so the user provisions into Entra / Microsoft 365.\n\nExchange\n- Enable the on-prem remote mailbox (Enable-RemoteMailbox) with the tenant routing address.\n- Wait for the mailbox to land in Exchange Online.\n- Set regional config (language / timezone) and grant the hiring manager Reviewer on the calendar.\n\nMicrosoft 365\n- Assign a seat-aware license: E5 if a seat is available, otherwise E3 (flag the fallback for review).\n- Add to the M365 / seat groups.\n\nServiceNow\n- Post a work note to the ticket and resolve the case.\n\nEquipment & access\n- Order the laptop and any monitor / keyboard / mouse / docking station per the request.\n- Fulfill any app / SaaS access not covered above.",
    "offboard": "Active Directory\n- Capture the user's group memberships as evidence, then remove them (Domain Users stays).\n- Reset the password and disable the account; set the hide-from-GAL attribute.\n- Do NOT move the OU (moving deletes the synced 365 account).\n\nExchange\n- Convert the mailbox to shared (unless over the size threshold — then keep it licensed).\n- Block ActiveSync / OWA; set out-of-office and forwarding on request.\n\nMicrosoft 365\n- Remove licenses once the mailbox is handled.\n\nServiceNow\n- Post a work note and resolve the case."
  }
}
