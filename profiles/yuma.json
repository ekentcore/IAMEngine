{
  "schemaVersion": "2.0",

  "client": {
    "id": "yuma",
    "name": "Yuma Holdings, LLC",
    "primaryDomain": "yumaai.com"
  },

  "kb": {
    "onboard":  { "number": "KB0018531", "sections": ["ServiceNow", "Microsoft 365", "Mimecast", "Case Resolution"] },
    "offboard": { "number": "KB0018533", "sections": ["ServiceNow", "Microsoft 365", "Hardware/Data (If Requested)", "Case Resolution"] }
  },

  "identity": {
    "backbone": "entra",
    "usernamePatterns": ["{first}@{domain}"],
    "password": { "mode": "generate", "minLength": 14, "onOffboard": "reset-and-capture" }
  },

  "secrets": {
    "m365-admin": { "provider": "delinea", "id": "REPLACE_ME", "label": "365 Admin Center" },
    "mimecast":   { "provider": "delinea", "id": "REPLACE_ME", "label": "Mimecast Admin Console" }
  },

  "delivery": { "method": "mimecast-secure-email" },

  "systems": [
    {
      "key": "servicenow", "mode": "api", "dependsOn": [],
      "onboard":  { "when": "always", "config": { "requiredFields": ["email", "phone", "location", "title"] } },
      "offboard": { "when": "always", "config": { "action": "mark-inactive-on-end-date" } }
    },
    {
      "key": "m365", "mode": "api", "secrets": ["m365-admin"], "dependsOn": ["servicenow"],
      "onboard": {
        "when": "always",
        "config": {
          "licenses": ["Microsoft 365 Business Premium", "Microsoft 365 Copilot"],
          "groups": ["All Company", "Mimecast Awareness Training", "Yuma Employees"],
          "dynamicGroups": ["All Users"],
          "dynamicGroupNote": "Dynamic membership — auto-included by rule; module verifies rather than adds.",
          "aliasOnRequest": true
        }
      },
      "offboard": {
        "when": "always", "captureEvidence": true,
        "dependsOn": ["exchange"],
        "config": { "blockSignIn": true, "removeManager": true, "removeAllGroups": true, "oneDriveBackup": { "target": "365 Admin OneDrive", "folder": "Offboarded User Data", "onlyIfRetentionUnderDays": 365 }, "removeLicense": true }
      }
    },
    {
      "key": "entra", "mode": "api", "secrets": ["m365-admin"], "dependsOn": [],
      "offboard": {
        "when": "always", "captureEvidence": true,
        "config": { "resetPassword": { "captureForDeliveryInM365Step": true }, "disableAccount": true, "removeAllGroups": true, "removeAppAccess": true, "revokeMfaSessions": true, "revokeActiveSessions": true }
      }
    },
    {
      "key": "exchange", "mode": "api", "secrets": ["m365-admin"], "dependsOn": ["entra"],
      "offboard": {
        "when": "always",
        "config": { "hideFromGal": true, "convertToShared": true, "onRequest": ["ooo-message", "email-forwarding", "email-delegates"], "blockMobileDevices": true, "disable": ["Exchange ActiveSync", "OWA (unless delegate access needed)"] }
      }
    },
    {
      "key": "mimecast", "mode": "api", "secrets": ["mimecast"], "dependsOn": ["m365"],
      "onboard": { "when": "always", "config": { "syncDirectory": true, "verifyInternalDirectory": "@yumaai.com" } }
    },
    {
      "key": "hardware", "mode": "manual", "dependsOn": [],
      "offboard": { "when": "on-request", "config": { "backupTarget": "client-specified", "removeProfiles": true } }
    },
    {
      "key": "case-resolution", "mode": "api", "dependsOn": ["m365", "mimecast"],
      "onboard":  { "when": "always", "config": { "deviceSetup": ["windows", "mac"], "sendCredentials": true, "closeAllTasks": true } },
      "offboard": { "when": "always", "config": { "deliverResetPasswordIfRequested": true, "closeAllTasks": true } }
    }
  ]
}
