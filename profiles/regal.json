{
  "schemaVersion": "2.0",

  "client": {
    "id": "regal",
    "name": "Regal Healthcare CM",
    "primaryDomain": "regalhcp.com",
    "pod": "POD-LifeSciences"
  },

  "identity": {
    "backbone": "ad-standalone",
    "usernamePatterns": ["{firstInitial}{last}"],
    "lowercase": true,
    "password": { "mode": "generate", "minLength": 14, "onOffboard": "reset-and-capture" }
  },

  "secrets": {
    "ad-dc":      { "provider": "delinea", "id": "REPLACE_ME", "label": "rhcp-dc1 / rchp-dc1 domain controller" },
    "m365-admin": { "provider": "delinea", "id": "REPLACE_ME", "label": "365 Admin Center" },
    "mimecast":   { "provider": "delinea", "id": "REPLACE_ME", "label": "Mimecast Admin Console" },
    "adobe":      { "provider": "delinea", "id": "REPLACE_ME", "label": "Adobe Admin Console" }
  },

  "delivery": { "method": "mimecast-secure-email" },

  "systems": [
    {
      "key": "servicenow", "mode": "manual", "dependsOn": [],
      "onboard":  { "when": "always", "config": { "requiredFields": ["email", "phone", "location", "title"] } },
      "offboard": { "when": "always", "config": { "action": "mark-inactive-on-end-date" } }
    },
    {
      "key": "active-directory", "mode": "api", "secrets": ["ad-dc"], "dependsOn": ["servicenow"],
      "onboard": {
        "when": "always",
        "config": {
          "ou": "rhcp.local > 1penn plaza > staff",
          "groupsOu": "rhcp.local > 1penn plaza > groups",
          "conditionalGroups": [ { "when": "vpn == true", "groups": ["VPN Users"] } ]
        }
      },
      "offboard": {
        "when": "always", "captureEvidence": true,
        "config": {
          "resetPassword": true,
          "removeFromGal": true,
          "removeManager": true,
          "removeAllGroups": true,
          "disableAccount": true,
          "moveToOu": "rhcp.local > 1penn plaza > Disabled Users"
        }
      }
    },
    {
      "key": "m365", "mode": "api", "secrets": ["m365-admin"], "dependsOn": [],
      "onboard": {
        "when": "always",
        "config": { "licenses": ["Office 365 E3"], "groupsOnRequest": true, "aliasesOnRequest": true, "note": "ad-standalone: 365 is independent of AD (no sync), provisioned separately, no dependsOn on AD." }
      },
      "offboard": {
        "when": "always", "captureEvidence": true,
        "config": {
          "blockSignIn": true,
          "removeAllGroups": true,
          "oneDriveBackup": { "target": "365 Admin OneDrive", "folder": "Offboarded User Data", "onlyIfRetentionUnderDays": 365 },
          "removeLicense": true
        }
      }
    },
    {
      "key": "entra", "mode": "api", "secrets": ["m365-admin"], "dependsOn": ["m365"],
      "offboard": {
        "when": "always", "captureEvidence": true,
        "config": { "ensureDisabled": true, "removeAllGroups": true, "removeAppAccess": true, "revokeMfaSessions": true, "revokeActiveSessions": true }
      }
    },
    {
      "key": "exchange", "mode": "api", "secrets": ["m365-admin"], "dependsOn": ["m365"],
      "offboard": {
        "when": "always",
        "config": { "convertToShared": true, "onRequest": ["ooo-message", "email-forwarding", "email-delegates"], "blockMobileDevices": true, "disable": ["Exchange ActiveSync"] }
      }
    },
    {
      "key": "mimecast", "mode": "api", "secrets": ["mimecast"], "dependsOn": ["m365"],
      "onboard": { "when": "always", "config": { "syncAll": true, "verifyInternalDirectory": "@regalhcp.com" } }
    },
    {
      "key": "adobe", "mode": "api", "secrets": ["adobe"], "dependsOn": ["m365"],
      "onboard":  { "when": "always", "config": { "assignLicense": true } },
      "offboard": { "when": "always", "config": { "removeLicense": true } }
    },
    {
      "key": "hardware", "mode": "manual", "dependsOn": [],
      "offboard": { "when": "on-request", "config": { "backupTarget": "requestor-specified", "removeProfiles": true } }
    },
    {
      "key": "case-resolution", "mode": "manual", "dependsOn": ["m365", "mimecast"],
      "onboard":  { "when": "always", "config": { "sendCredentials": true, "closeAllTasks": true } },
      "offboard": { "when": "always", "config": { "deliverResetPasswordIfRequested": true, "closeAllTasks": true } }
    }
  ]
}
