// iam-engine database — PostgreSQL via Prisma
// Normalizes the v2 client profiles (profiles/_schema.json) into rows.
// Run: npx prisma migrate dev && npx prisma db seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Backbone {
  entra
  google
  ad_synced
  ad_standalone
}

enum ClientStatus {
  active
  archived
}

enum Mode {
  api
  browser
  manual
  scim // provisioned automatically by identity-provider SCIM push — planned as a visible step, auto-satisfied so the case keeps moving
}

enum Lifecycle {
  always
  on_request
  never
  by_persona // included only when the selected persona's bundle lists this system
}

enum Action {
  onboard
  offboard
  change
}

enum CaseStatus {
  queued
  planning
  running
  needs_manual
  needs_approval
  completed
  failed
}

enum JobStatus {
  pending
  dispatched
  running
  succeeded
  failed
  manual
  skipped
}

enum AgentScope {
  central
  client_network
}

model Client {
  id                     String       @id @default(cuid())
  slug                   String       @unique
  name                   String
  primaryDomain          String // website domain (from SN `website`) — informational
  domains                String[]
  // Email/UPN domain, derived from the dominant domain of the client's SN contacts (ground truth,
  // vs the website which often differs). Used for identity derivation. emailDomainLocked = a human
  // curated it; sync + contact-derivation must not overwrite a locked value.
  emailDomain            String?
  emailDomainLocked      Boolean      @default(false)
  // Field names hand-edited in the UI (e.g. "primaryDomain", "backbone"). The routine ServiceNow
  // sync skips these so a manual correction isn't clobbered; a "hard refresh" clears them and
  // overwrites from ServiceNow.
  editedFields           String[]     @default([])
  backbone               Backbone? // null = roster-only (pulled from ServiceNow, not yet modeled by a profile)
  pod                    String?
  // ServiceNow account hierarchy: children (e.g. CORE2181..89 under CORE1456) share the parent's
  // onboarding. When a child has NO modeled systems, planning falls back to the parent's systems +
  // modeling (see clientForPlanning). Synced from customer_account.parent.
  parentId               String?
  parent                 Client?      @relation("ClientParent", fields: [parentId], references: [id])
  children               Client[]     @relation("ClientParent")
  identity               Json? // profile identity: { usernamePatterns, password, directorySync } — drives the automation preview
  // v2.1 plan-time resolution inputs (from the profile): role/persona bundles, every-user config
  // fragments, and the location data table. The planner merges these into each job's config.
  personas               Json?
  globals                Json? // every-user ONBOARD rules (add groups, place OU, set attributes)
  globalsOffboard        Json? // every-user OFFBOARD rules (remove groups, move OU, set attributes)
  locations              Json?
  // Per-contact intake rules (FR #0000019): when a configured ServiceNow contact submits an onboard
  // case, skip named systems and force an email domain. Shape:
  // { rules: [ { id, label, match: { contacts: [{ sysId, name }] }, effects: { skipSystems: string[], forceDomain: string } } ] }
  // First matching rule wins; onboard-only. Evaluated in matchIntakeRule at plan/replan time.
  intakeRules            Json?
  // AD objects discovered from the client's DC by its agent (read-only Get-ADOrganizationalUnit /
  // Get-ADGroup), to back the rules editor's OU/group pickers. { ous: string[], groups: string[],
  // discoveredAt }. adDiscoverRequestedAt is set by the "Refresh AD objects" button and consumed by
  // the next client-network heartbeat (which tells the agent to run discovery).
  adObjects              Json?
  adDiscoverRequestedAt  DateTime?
  // The user who requested the last AD/cloud discovery — so the runner's RESULT audit (which the
  // runner writes as "agent:<id>") can be attributed to the human who kicked it off, not the agent.
  // Persisted at request time; read when the result lands; overwritten by the next request.
  adDiscoverRequestedById   String?
  // Cloud (Entra) groups discovered from the tenant via the m365-admin secret (Get-MgGroup), to back
  // the same group pickers for cloud-only groups AD sync never covers — DLs, Security, M365 Groups.
  // { groups: [{ name, type }], discoveredAt }. cloudGroupsRequestedAt is set by "Refresh cloud
  // groups" and consumed by the CENTRAL runner (it has Graph), which posts the result back.
  cloudGroups            Json?
  cloudGroupsRequestedAt DateTime?
  cloudGroupsRequestedById  String? // who requested the last cloud discovery — see adDiscoverRequestedById
  // Shared mailboxes discovered from Exchange Online alongside the cloud groups (same "Refresh"
  // request flag; the central runner enumerates Get-Mailbox -RecipientTypeDetails SharedMailbox when
  // the m365-admin secret carries an EXO cert). Backs the per-client "default shared-mailbox access"
  // picker (FR #15). Shape: { mailboxes: [{ address, displayName }], discoveredAt }.
  cloudMailboxes         Json?
  status                 ClientStatus @default(active)
  // Where this client's onboarding/offboarding requests come from, so case-scanning hits the right
  // ServiceNow table: "um" = external clients (sn_customerservice_user_management cases, the default),
  // "incident" = internal (Coretelligent's own onboarding incidents, subcategory "User / On-Boarding",
  // whose form data lives in record-producer variables, not columns).
  intakeSource           String       @default("um")
  // Internal-only: a restricted client is hidden from every operator EXCEPT those explicitly granted
  // it (and super admins), regardless of their access mode. Use for sensitive orgs like Coretelligent.
  restricted             Boolean      @default(false)
  // "Do not use engine": this client's ServiceNow cases are never imported — the intake sweep skips
  // them (counted as skipped, not failed) and a manual import refuses. For clients handled entirely
  // outside the engine. Cases already imported are untouched.
  engineOptOut           Boolean      @default(false)
  // Parent-systems inheritance (SN account hierarchy): by default a child with NO modeled systems
  // plans from its parent (see clientForPlanning). Set false to break that link for a child that
  // doesn't match its parent — it then plans from its own (possibly copied) systems, or reads
  // unmodeled if it has none.
  inheritParentSystems   Boolean      @default(true)
  // When true AND this client has its own (client-network) agent, ALL of its jobs — including cloud
  // ones (m365/exchange) — are claimed by that agent, not the central runner. Lets a client run
  // everything on-prem the way its native script did (e.g. Windows-store EXO cert). Falls back to the
  // central runner if the client has no agent. Off by default (cloud jobs go to the central runner).
  runCloudOnOwnAgent     Boolean      @default(false)
  // Per-client notification override: this client's own Zoom channel for failure alerts.
  // { webhookUrl, token, mode: "also" | "only" } — "also" = client channel PLUS the default/restricted
  // base, "only" = client channel alone. Null = use the global routing (default vs restricted).
  notifyOverride         Json?
  // Delinea (Secret Server) folder id this client's secrets are CREATED in when an operator authors a
  // credential in-app (the write path — see lib/secrets/delinea-templates.ts). Read-only brokering
  // never needs it. Falls back to DELINEA_FOLDER_MAP[slug] when null; null + no env entry = the
  // in-app "Create in Delinea" affordance is disabled for this client.
  delineaFolderId        String?
  createdAt              DateTime     @default(now())
  archivedAt             DateTime?

  // --- ServiceNow roster fields (source of truth for which clients exist) ---
  serviceNowSysId   String?   @unique // CSM customer_account sys_id
  coreId            String?   @unique // u_core_id, e.g. "CORE832"
  region            String? // u_region (Core, Olympus, ...)
  timezone          String? // u_time_zone
  supportStatus     String? // u_support_status
  coManaged         Boolean   @default(false) // u_comanaged_it
  onboardingRating  Int? // u_onboarding raw 1|2|3 (null if a text choice)
  offboardingRating Int? // u_offboarding raw 1|2|3 (null if a text choice)
  snLastSyncedAt    DateTime? // last successful ServiceNow sync for this row
  metadata          Json? // raw SN choice labels (e.g. offboarding = "Document Missing")

  systems         ClientSystem[]
  secrets         Secret[]
  agents          Agent[]
  cases           CaseRequest[]
  runbook         RunbookSection[]
  connectionTests ConnectionTest[]
  setupStates     SystemSetupState[]
  connHealth      ConnHealthState[]
  userAccess      UserClientAccess[]
  setupCredentials ModuleSetupCredential[]
}

model SystemCatalog {
  key              String         @id // servicenow, m365, active-directory, ...
  name             String
  defaultMode      Mode           @default(api)
  supportsOnboard  Boolean        @default(true)
  supportsOffboard Boolean        @default(true)
  moduleName       String? // e.g. Coretelligent.M365
  buildTier        Int            @default(3) // 1 = core/built, 3 = long tail
  clientSystems    ClientSystem[]
}

model ClientSystem {
  id               String        @id @default(cuid())
  client           Client        @relation(fields: [clientId], references: [id])
  clientId         String
  system           SystemCatalog @relation(fields: [systemKey], references: [key])
  systemKey        String
  mode             Mode
  onboardWhen      Lifecycle     @default(never)
  offboardWhen     Lifecycle     @default(never)
  dependsOn        String[] // system keys
  requiresApproval Boolean       @default(false)
  captureEvidence  Boolean       @default(false)
  secretNames      String[] // references Secret.name for this client
  config           Json? // per-client, per-lane settings (loose)

  @@unique([clientId, systemKey])
}

model Secret {
  id         String  @id @default(cuid())
  client     Client  @relation(fields: [clientId], references: [id])
  clientId   String
  name       String // logical key used by ClientSystem.secretNames
  provider   String  @default("delinea")
  externalId String // Delinea secret id — NEVER a value
  label      String?
  // Credential expiry, captured OPPORTUNISTICALLY from Delinea metadata whenever the secret is
  // checked or brokered (never from the value). Null = Delinea doesn't expose one for this secret.
  expiresAt         DateTime?
  expiryCheckedAt   DateTime?
  expiryNotifiedAt  DateTime? // last credExpiring alert for this secret (renotify window)

  @@unique([clientId, name])
}

// Durable per-(client, system) connection-health snapshot. ConnectionTest rows are DELETED and
// recreated on every run, so new-failure detection and notification suppression live here: written
// by reportConnectionTest on every result, never deleted by a re-run. Sweep-sourced NEW failures
// set pendingNotifyAt and are flushed (individually or as one digest) by the conn sweep;
// failNotifiedAt stops repeats until the system recovers.
model ConnHealthState {
  id               String    @id @default(cuid())
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId         String
  systemKey        String
  lastStatus       String // ok | fail
  lastDetail       String?
  lastOkAt         DateTime?
  lastFailAt       DateTime?
  credExpiresAt    DateTime? // nearest credential expiry the probe reported (e.g. Graph app secret)
  pendingNotifyAt  DateTime? // a sweep-sourced NEW failure awaiting the digest flush
  failNotifiedAt   DateTime? // cleared on recovery — re-arms future alerts
  expiryNotifiedAt DateTime?
  updatedAt        DateTime  @updatedAt

  @@unique([clientId, systemKey])
  @@index([pendingNotifyAt])
}

model Agent {
  id                 String     @id @default(cuid())
  client             Client?    @relation(fields: [clientId], references: [id])
  clientId           String? // null for the central cloud runner
  name               String
  scope              AgentScope
  version            String? // the content-hash build id (canonical "on current code?" check)
  semver             String? // the human-readable release version from runner/VERSION (display only)
  // Which ALWAYS_ON_PREM system keys this host can actually execute (its host-specific Coretelligent
  // module loaded) — reported each heartbeat as a JSON string[]. The claim gate withholds an on-prem
  // job from an agent that doesn't list it (e.g. a DC missing RSAT), so it stays pending with a clear
  // reason instead of being dispatched and hard-failing. NULL = a legacy runner that doesn't report
  // (treated as capable, preserving pre-capability behavior); [] = reports it can run no on-prem system.
  capabilities       Json?
  // Failover priority among peer runners of the SAME scope (a client's agents, or all central runners).
  // LOWER = higher priority. A runner stands by (claims nothing) while a STRICTLY-higher-priority peer of
  // its scope is online, and takes over when that peer goes silent — so a backup DC / second central
  // runner only runs when the primary is down. Equal priority = load-balance (the pre-failover behavior).
  priority           Int        @default(100)
  lastSeenAt         DateTime?
  // The runner process's start time (reported each heartbeat) — drives the Agents "uptime" display.
  // Resets on a restart/self-update (that's a new process), so uptime is "up since this launch".
  bootAt             DateTime?
  enabled            Boolean    @default(true)
  // Operator-requested self-update: set true by the "Update" button; the next heartbeat returns
  // update:true (consumed — cleared to false), and the runner re-pulls its files and restarts.
  // The two timestamps drive the UI status: requested (queued) -> delivered (agent pulling/
  // restarting) -> back online (lastSeenAt > delivered).
  updateRequested    Boolean    @default(false)
  updateRequestedAt  DateTime?
  updateRequestedBy  String? // operator (email) who pushed the last self-update — for the Agents page
  updateDeliveredAt  DateTime?
  // Operator-requested plain RESTART (no file pull): the "Restart" button sets it; the next heartbeat
  // returns restart:true (consumed) and the runner re-execs (its supervisor relaunches it). Clears a
  // wedged claim/work loop remotely without touching the box.
  restartRequested   Boolean    @default(false)
  restartRequestedAt DateTime?
  restartRequestedBy String?
  restartDeliveredAt DateTime?
  // Operator-driven app-URL migration. The agent reports its current base URL each heartbeat
  // (currentAppUrl); a global target (AppSetting agent_migration) + this per-agent canary flag make
  // the heartbeat return migrate:{appUrl}. The runner verifies the new URL, rewrites its own supervisor
  // entry (old URL removed), and switches. migratedAt is stamped once the agent reports the new URL;
  // migrateError carries the last failure the agent reported (unreachable / rewrite failed).
  currentAppUrl      String?
  migrateRequested   Boolean    @default(false)
  migrateRequestedAt DateTime?
  migrateRequestedBy String?
  migrateDeliveredAt DateTime?
  migratedAt         DateTime?
  migrateError       String?
  // Soft-delete: a disabled runner moved to the trash. Restorable for 30 days, then purged.
  deletedAt          DateTime?
  jobs               Job[]

  @@index([deletedAt])
}

// Operator-entered setup state for one (client, system) pair — the bits of the setup checklist
// that can't be DERIVED from live state: "setup started" and "I verified rights manually" (the
// attestation that also overrides the dispatch gate). Deliberately keyed by systemKey with NO FK
// to ClientSystem: replaceSystems deletes+recreates system rows wholesale, and attestation must
// survive an edit to the system set. Cascades only with the client itself.
model SystemSetupState {
  id         String    @id @default(cuid())
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  systemKey  String
  startedAt  DateTime? // operator opened/acknowledged the setup instructions
  startedBy  String?
  attestedAt DateTime? // operator attests the credential's RIGHTS were verified manually
  attestedBy String?
  attestNote String?

  @@unique([clientId, systemKey])
}

// A one-off "does the credential actually connect, with the right permissions?" probe. ISOLATED
// from the Job/CaseRequest pipeline so a probe can never affect a real onboarding: its own table,
// its own claim, its own runner loop. Routed like a job — cloud systems to the central runner, on-
// prem (AD/sync, hybrid Exchange) to the client agent — via the onPrem flag the app stamps.
model ConnectionTest {
  id              String    @id @default(cuid())
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId        String
  systemKey       String
  status          String    @default("pending") // pending | running | ok | fail (overall)
  detail          String? // the API stage's one-line summary ("users readable") or its error
  // Two-stage result: accessOk = the runner could RESOLVE the secret from Delinea; the API stage
  // (status/detail) = connect + one live read worked. Null until a (new) runner reports them.
  accessOk        Boolean?
  accessDetail    String?
  // App-side preflight stage, stamped at REQUEST time (before any runner claims it): the app itself
  // resolved each secret from Delinea and shape-checked its field names. Null = preflight not run
  // (Delinea unconfigured on the app, or an older row).
  fieldsOk        Boolean?
  fieldsDetail    String?
  // Per-operation rights results from the runner's probe: [{ op, ok, detail }] where ok=null means
  // "cannot verify automatically — check manually". Null = older runner or no rights-aware probe.
  rights          Json?
  // Nearest expiry of the credential itself when the probe can read it (e.g. the Graph app secret's
  // passwordCredentials endDateTime). Null = unknown/unreadable.
  credExpiresAt   DateTime?
  source          String    @default("manual") // manual (operator button) | sweep (scheduled fleet run)
  // Deep probes are allowed on this test: expensive/INTERACTIVE checks that a routine test must never
  // do — today, signing in to a vendor portal in a real browser (Spanning's console, via M365 SSO).
  // Set ONLY when an operator retests ONE system on ONE client, so it can't fan out: a nightly sweep
  // or the fleet button would otherwise fire a real M365 sign-in per client per run, which floods the
  // sign-in logs and is exactly the burst of scripted logins that risk-based Conditional Access
  // challenges. Orthogonal to `source` on purpose — the fleet button is operator-initiated too.
  deep            Boolean   @default(false)
  onPrem          Boolean   @default(false) // true -> only the client's agent claims it
  secretNames     String[]  @default([]) // the system's REQUIRED secrets — a failure to resolve one fails the test
  // Secrets for an optional capability (e.g. spanning-portal, the console sign-in behind force-sync).
  // Brokered BEST-EFFORT: they're authorized for this test, but if one can't be resolved the test must
  // still pass on the strength of the required ones — licensing doesn't care that force-sync is broken.
  // Only ever populated with secrets the client has actually wired.
  optionalSecretNames String[] @default([])
  config          Json? // the ClientSystem.config, so a conn-test Connect can read e.g. onPremExchangeUri
  requestedAt     DateTime  @default(now())
  claimedAt       DateTime?
  finishedAt      DateTime?
  assignedAgentId String?

  @@index([status])
  @@index([clientId])
}

model CaseRequest {
  id                   String     @id @default(cuid())
  client               Client     @relation(fields: [clientId], references: [id])
  clientId             String
  action               Action
  serviceNowCaseNumber String?    @unique // e.g. UM0028698 — used to make import idempotent
  subject              String? // short description for list display
  status               CaseStatus @default(queued)
  // When true, dispatched jobs run -WhatIf (read-only validation, NO mutations). Propagated onto
  // each pending job's request.dryRun; toggled on the case before dispatch for a safe first run.
  dryRun               Boolean    @default(false)
  payload              Json // the ServiceNow intake form (see DATA_MODEL.md)
  // Per-case secret-reference overrides: { "<secretName>": "<delinea externalId>" }. The credential
  // broker prefers these over the client's default reference — for a one-off cred or to fill one the
  // client hasn't set. Still a REFERENCE only (a Delinea id), never a value.
  secretOverrides      Json?
  // Operator-chosen email domain for THIS case (a multi-domain client's non-default domain).
  // Consulted by replan as precedence tier 1 (see resolveEmailDomain); null = client default.
  emailDomainOverride  String?
  // Set once the post-onboard verification sweep (re-run of every step's read-only validator) has
  // completed — so it auto-runs exactly once before the case is considered done, and case-resolution.
  verifiedAt           DateTime?
  // Operator pause: a paused case's jobs are never claimed (the runner skips them) until resumed.
  // Use it to safely adjust systems / re-plan mid-run without a runner grabbing the next step.
  pausedAt             DateTime?
  // Why it's held: "operator" (manual pause) or "needs_info" (intake had unknowns to fill before it
  // can run — the case is auto-held on import and released once the fields are provided).
  pausedReason         String?
  // Scheduled auto-resume: at this time the heartbeat sweep releases the hold and runners start
  // claiming. scheduledBy is a plain snapshot of the operator's email who set it.
  scheduledFor         DateTime?
  scheduledBy          String?
  createdAt            DateTime   @default(now())
  // WHO opened this case, captured at creation. `createdBy` is the actor-label snapshot
  // ("user:jane@core.tech" | "system:intake-poll") so it survives the user row being deleted;
  // `createdByUserId` is the joinable FK, set only for a real signed-in operator. `createdSource`
  // says HOW it was opened, so "which cases did a human hand-key?" is a column filter
  // (createdSource = manual) rather than an archaeology dig through AuditLog.
  createdBy            String?
  createdByUserId      String?
  createdByUser        User?      @relation("CaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdSource        CaseSource @default(manual)
  // ONE-TIME initial password for a "generate"-mode onboard: the app generates it at dispatch (so it
  // knows the value), injects it as the runner's initial password, and stores it here to reveal to the
  // operator EXACTLY ONCE (the reveal wipes it). Never logged / never in Job.result or audit.
  initialPassword      String?
  // Soft-delete: a case moved to the trash (removed from the list). Restorable for 30 days, then
  // purged. Excluded from the active list and from runner claims while trashed.
  deletedAt            DateTime?
  // Operator dismissed this case's WARNINGS ("I finished the remaining steps by hand") — the run
  // report shows the steps as accepted and the cases list stops painting the case orange. Cleared
  // automatically when a new real (non-verify) result lands, so fresh problems resurface.
  warningsDismissedAt  DateTime?
  warningsDismissedBy  String?
  jobs                 Job[]

  @@index([deletedAt])
  @@index([clientId]) // client-network agents claim by case.clientId; client pages filter by it
  @@index([scheduledFor]) // the every-~minute sweepScheduledCases due-case query
  @@index([createdByUserId]) // "what did this engineer open?"
  @@index([createdSource, createdAt]) // "every hand-keyed case this week"
}

// How a case came to exist. `manual` = an operator hand-keyed it in the New case dialog (no
// ServiceNow number); `servicenow` = an operator imported a specific ticket; `intake_poll` = the
// background sweep pulled it in unattended; `sim` = the CLI simulator; `api` = anything else
// programmatic. The default is `manual` because that's the only path a human drives directly.
enum CaseSource {
  manual
  servicenow
  intake_poll
  sim
  api
}

model Job {
  id               String            @id @default(cuid())
  case             CaseRequest       @relation(fields: [caseRequestId], references: [id])
  caseRequestId    String
  systemKey        String
  sequence         Int
  mode             Mode
  status           JobStatus         @default(pending)
  assignedAgent    Agent?            @relation(fields: [assignedAgentId], references: [id])
  assignedAgentId  String?
  request          Json? // resolved instructions for the runner
  singleRun        Boolean           @default(false) // operator "run this step only": claimable even while the case is paused, runs in isolation (no cascade), cleared on result
  oneTimePassword  String? // ad-hoc password-reset jobs only: the generated value, injected into the runner config at claim, revealed to the operator ONCE then wiped (also wiped on failure) — never in result/audit
  result           Json?
  evidence         Json? // screenshots / membership snapshots refs
  validation       Json? // post-action read-back: { ok, checks:[{name,expected,actual,pass}] }
  progress         Json? // live phase trail while running: [{ ts, phase }] — shown in the run report
  progressAt       DateTime? // when progress last moved — the per-job "is it still working?" signal
  error            String?
  // WHY the credential broker last failed for this job (code/secretName/externalId/fix) — stamped by
  // brokerCredential, cleared on a clean broker, copied onto the RunOutcome so fixes can be scripted.
  credFailure      Json?
  startedAt        DateTime?
  finishedAt       DateTime?
  procurementWatch ProcurementWatch?

  // Hot path: runners poll every ~5s and each claim runs three scans over this table (candidate fetch,
  // stale-lease reclaim, wedged-job reclaim). Index the columns those queries filter on.
  @@index([status, mode]) // candidate fetch
  @@index([status, startedAt]) // stale dispatched-lease reclaim
  @@index([status, progressAt]) // wedged running-job reclaim
  @@index([caseRequestId]) // per-case job load (run report, case advance)
  @@index([assignedAgentId]) // agent's in-flight jobs
}

// A Procurement Case (SN) being watched for a job that couldn't finish for lack of license seats.
// Heartbeat-driven sweep checks the PC's state every ~5 minutes; when it resolves, the job is
// automatically re-queued (re-runs the assignment + verifies). One watch per job.
model ProcurementWatch {
  id            String    @id @default(cuid())
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId         String    @unique
  number        String // e.g. PC0012345
  state         String    @default("watching") // watching | resolved | cancelled | error
  note          String? // last observed SN state / error detail
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// The full per-client runbook, generated from the KB by tools/profile-generator and loaded
// at seed time. Every section (modeled + not-yet-modeled) in document order, with its steps,
// so the UI can show the complete onboarding/offboarding picture incl. human-interaction work.
model RunbookSection {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  action    Action
  seq       Int
  systemKey String? // null when the section is not modeled as a system yet
  title     String // the runbook section header
  status    String // automated | manual | unmodeled
  guess     String? // vendor guess for an unmodeled section
  steps     String[] // ordered runbook steps (nested items indented)
  kbArticle String? // source ServiceNow KB number for this action (e.g. KB0034662)
  artifacts Json? // typed non-step content: email templates, linked attachments

  @@index([clientId, action, seq])
}

model AuditLog {
  id            String   @id @default(cuid())
  at            DateTime @default(now())
  actor         String // system | ui | agent:<id> | user:<email> — human label, kept for non-user rows
  userId        String? // FK when a logged-in operator performed the action (per-user audit trail)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientId      String?
  caseRequestId String?
  jobId         String?
  action        String
  detail        Json?

  @@index([userId, at])
  @@index([action, at])
  @@index([at])
  @@index([caseRequestId]) // listCases loads recent audit rows per case (action IN … WHERE caseRequestId IN …)
}

// Append-only outcome log: one row per job result post. Unlike Job (overwritten in place on a
// re-run), this preserves the history of successes / warnings / errors so module problems can be
// tracked and fixed across cases. Backs the /runs page.
model RunOutcome {
  id            String    @id @default(cuid())
  at            DateTime  @default(now())
  caseRequestId String
  caseNumber    String // SN UM number (else the case id) — shown in the log
  action        Action // onboard | offboard
  clientId      String
  clientName    String
  systemKey     String // the module / system that ran
  verdict       String // verified | warning | failed | skipped | manual
  status        String // raw job status: succeeded | failed | skipped
  messages      String[] // warning / error / validation-miss lines (empty for a clean success)
  error         String? // the top-level failure message, if any
  validateOnly  Boolean   @default(false) // true = an auto-verify read-back, not the action run
  // Stable hash of (case + module + verdict + messages + error): the SAME line for the SAME case
  // recurs across re-runs under one fingerprint, so marking it "Fixed" resolves every occurrence and
  // the log collapses duplicates instead of repeating noise.
  // Structured credential-failure detail copied from the Job (see Job.credFailure) when the run's
  // problem was a credential — { code, secretName, externalId?, source?, fix?, detail } — so /runs
  // and remediation scripts act on the CODE instead of parsing the error text.
  credFailure   Json?
  fingerprint   String    @default("")
  resolvedAt    DateTime? // set when an operator marks the line "Fixed" (hides it from the default view)
  resolvedBy    String? // who resolved it (email / "system")

  @@index([systemKey, verdict, at])
  @@index([clientId, at])
  @@index([verdict, at])
  @@index([at])
  @@index([fingerprint])
  @@index([resolvedAt])
}

// A "self-healing" fix task: an LLM tool-calling session (scripts/llm-fix.mjs, provider from the
// LlmProvider registry) reads the code, diagnoses a failing run-log line, and stores a structured
// fix PROPOSAL (file + lines + old/new text) for on-screen review. An operator then applies it:
// isolated git worktree → drift check → tsc/tests → DRAFT PR — a human always merges. One
// unfinished task per fingerprint — enforced by the API AND by a partial unique index
// (in the migrations: UNIQUE(fingerprint) WHERE status IN ('queued','running','applying')) so a
// race can't fan the same failure out into parallel fixers.
model FixTask {
  id          String    @id @default(cuid())
  fingerprint String // the RunOutcome fingerprint that triggered it
  title       String // short description shown in UI (e.g. "m365: license assignment failed")
  context     String // the error text handed to the LLM (the run-log line's copy text)
  status      String    @default("queued") // queued | running | proposed | no_change | failed | applying | opened_pr | dismissed
  branch      String? // claude-fixes/<id>
  prUrl       String? // the draft PR, when one was opened
  log         String? // diagnosis / provider error tail
  proposal    Json? // { diagnosis, edits: [{ file, startLine, endLine, oldText, newText, note? }] }
  provider    String? // "name (model)" snapshot of the LlmProvider that analyzed it
  requestedBy String? // operator email or "system:auto-fix"
  appliedBy   String? // operator who clicked Apply & open draft PR
  appliedAt   DateTime?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([fingerprint])
}

// An LLM provider the fix lane can use — an extensible registry edited on the Settings page
// (presets: Claude, OpenAI, OpenRouter, Azure AI, Hugging Face; any OpenAI-compatible endpoint
// works). The API key is entered in Settings and stored here: a deliberate, platform-level
// exception to the "secrets only in Delinea" rule for CLIENT credentials. The key never leaves
// the server — every API response masks it to its last 4 characters.
model LlmProvider {
  id         String   @id @default(cuid())
  name       String // display name, e.g. "Claude", "OpenRouter"
  adapter    String // "anthropic" | "openai-compatible"
  baseUrl    String // e.g. https://api.anthropic.com, https://openrouter.ai/api/v1
  model      String // e.g. claude-sonnet-5, gpt-4o, meta-llama/Llama-3.3-70B-Instruct
  apiKey     String // server-side only; masked in all API responses
  // Optional ?api-version= query appended to openai-compatible calls. Azure's classic
  // /openai/deployments/{id} path REQUIRES it; its newer /openai/v1 path defaults to "v1" and
  // takes "preview" to opt into preview features. Null/empty for OpenAI, OpenRouter, HF.
  apiVersion String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Documents: the platform's own reference documents, versioned in-app ───────
// The client overview, setup guide, security design, and internal reference. Each Document is a
// slug + audience; its content is a chain of DocumentVersions (Markdown). The newest PUBLISHED
// version is what the /docs page shows and what downloads (md/html/docx) render from. An "Update
// with AI" run reads the change log since the last version and produces a DRAFT version an admin
// reviews (diff + change note) before it publishes. Content is Markdown, never a secret — these
// are our own docs, so they live in the app DB (unlike client credentials).

// Who may see a document. Enforced server-side in lib/docs/access.ts, not just by hiding links.
enum DocAudience {
  client // client-facing (engineer and above may view/download)
  internal // Coretelligent staff only (global_admin and above)
}

enum DocVersionStatus {
  draft // an AI-proposed (or hand-authored) revision awaiting review; never shown/served publicly
  published // the live content; the newest published version is the current one
}

model Document {
  id        String            @id @default(cuid())
  slug      String            @unique // stable url + download filename, e.g. "security-design"
  title     String
  audience  DocAudience       @default(client)
  summary   String? // one-line blurb for the docs list
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  versions  DocumentVersion[]
}

model DocumentVersion {
  id         String           @id @default(cuid())
  documentId String
  document   Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    String // "1.0", "1.1", "2.0" — unique within a document
  status     DocVersionStatus @default(draft)
  markdown   String
  // What changed vs the version this was based on — shown in the on-document version table. For an
  // AI draft this is the model's own summary of its edits; for the seed it's "Initial version".
  changeNote String?
  generatedByAi    Boolean   @default(false)
  // ISO date (YYYY-MM-DD) of the newest change-log entry folded into this version, so the next AI
  // update only considers entries newer than this and we never re-apply the same log twice.
  changelogThrough String?
  // Attribution snapshot (no FK: a version's provenance must survive the operator being deleted).
  createdById    String? // User.id of the operator who created/published it, when known
  createdByLabel String? // "Seed", or the operator's email — what the version table displays
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@unique([documentId, version])
  @@index([documentId, status])
}

// ── Auth: operators, their roles, and live sessions ──────────────────────────
// Role is a coarse bucket; lib/auth/permissions.ts maps each Role to a fine permission set, so
// authorization is permission-based and roles stay easy to re-compose.
enum Role {
  super_admin // top tier: everything a global admin can do, plus only a super can reset/assign supers
  global_admin // everything incl. user/role + settings + approve destructive (but not supers)
  ops_manager // all case ops + approve destructive + edit systems + manage agents
  engineer // import/plan/dispatch/rerun/pause/verify/schedule; NOT approve destructive
  importer // import + view only
  auditor // read-only everywhere + audit log
  client_onboarding // add + modify + set up clients (systems/credentials); NOT run cases, NOT archive
  client_offboarding // like client_onboarding, plus archiving clients (archive is restricted to this + global/super)
}

enum AuthType {
  local // email + password (Admin control, break-glass)
  sso // Entra / O365 OIDC
  both
}

// How a user's client visibility is scoped (see lib/auth/client-scope.ts for the resolution rule):
//   all     — every client EXCEPT restricted ones the user hasn't been granted (the default)
//   only     — ONLY the clients in the user's scope list (an allowlist; a restricted client listed
//              here is thereby granted)
//   exclude  — every client EXCEPT the ones in the user's scope list (and except ungranted restricted)
enum ClientAccessMode {
  all
  only
  exclude
}

// A row in the user↔client access junction. Two kinds share one table:
//   scope — the client list the only/exclude mode operates on
//   grant — explicit access to a `restricted` (internal-only) client, consulted for all/exclude users
enum ClientAccessKind {
  scope
  grant
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  name             String?
  role             Role               @default(auditor) // least privilege by default; an admin elevates
  status           String             @default("active") // active | disabled
  authType         AuthType           @default(local)
  passwordHash     String? // scrypt(salt:hash); local accounts only
  isBreakGlass     Boolean            @default(false) // emergency local super-admin — use is loudly audited
  mfaSecret        String? // TOTP seed (optional; reserved)
  entraOid         String?            @unique // Entra object id, set when linked to an O365 identity
  lastLoginAt      DateTime?
  // Which clients this operator may see. `all` (default) preserves today's behavior — everyone sees
  // every non-restricted client — so the feature is inert until an admin scopes a user down.
  clientAccessMode ClientAccessMode   @default(all)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sessions         Session[]
  auditLogs        AuditLog[]
  createdCases     CaseRequest[]      @relation("CaseCreatedBy")
  clientAccess     UserClientAccess[]
}

// A verified SSO sign-in from someone who ISN'T a provisioned user — captured (instead of a silent
// deny) so an admin can approve them from /users. Deny-by-default stays intact: nothing is granted
// until an admin approves, choosing the role (default auditor) and client scope (default: none).
model AccessRequest {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String? // display name from the SSO identity
  status           String    @default("pending") // pending | approved | denied
  requestCount     Int       @default(1) // how many times they've tried to sign in
  firstRequestedAt DateTime  @default(now())
  lastRequestedAt  DateTime  @default(now())
  reviewedBy       String? // operator email who approved/denied
  reviewedAt       DateTime?

  @@index([status, lastRequestedAt])
}

// Per-user client visibility. `scope` rows are the only/exclude list; `grant` rows unlock a
// restricted client for this user. Enforced server-side at every read path via lib/auth/client-scope.
model UserClientAccess {
  userId   String
  clientId String
  kind     ClientAccessKind
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([userId, clientId, kind])
  @@index([clientId])
}

model Session {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // Impersonation (super-admin "view as"): when set, the session RENDERS as this user (their RBAC +
  // client scope) while the real operator stays `userId`. Plain id (no FK) so a deleted target just
  // falls back to the real user. Mutations are blocked while set (see requirePermission).
  impersonatingUserId String?
  tokenHash String    @unique // sha256 of the opaque cookie token (the token itself is never stored)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

// In-app feature-request box: any operator files one from the 💡 header button; settings.manage
// triages via /settings. authorUserId is a plain id (no FK) — like Session.impersonatingUserId —
// so a deleted author never blocks or cascades a request.
model FeatureRequest {
  id             String    @id @default(cuid())
  number         Int       @unique @default(autoincrement()) // the ticket number operators quote — rendered #0000001
  title          String
  body           String
  page           String // pathname the request was filed from
  status         String    @default("new") // new | planned | building | done | declined
  resolutionNote String?
  // The moment the request drops off the board into the collapsed Completed table. Null = on the
  // board. Hidden is DERIVED (hideAt <= now), never a stored flag, so the 7-day timer needs no cron:
  // flipping to "done" arms it at now+7d, and feature_request.hide holders can set it to now (hide
  // sooner) or push it to now+7d again (unhide for another 7 days).
  hideAt         DateTime?
  authorUserId   String?
  authorEmail    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([createdAt])
}

// App-level singleton key/value state (no per-client owner). Holds the ServiceNow intake poller's
// enabled flag + high-water mark, and is the home for future app settings. Value is JSON-as-text.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// A fleet-wide M365 sweep and its findings.
//
// Two kinds, both answering a question the per-client UI cannot:
//   permissions  — which app registrations are missing a Graph permission ("who needs
//                  UserAuthenticationMethod.ReadWrite.All?"). Per-client gaps are already visible in
//                  the connection-test panel; only a sweep can pivot them by permission.
//   leaked_seats — disabled users still holding a licence, i.e. leavers we are still paying for.
//
// The findings are a JSON blob rather than a row-per-finding table on purpose: a run is a SNAPSHOT
// A low-code connector: a declarative definition (docs/CONNECTOR_BUILDER.md) that the generic
// Coretelligent.Connector executor (kind "http") or the connector-steps browser flow (kind "browser")
// interprets at run time. Publishing upserts the SystemCatalog row (key = this key, moduleName
// "Coretelligent.Connector") so clients attach it like any built-in system; the published definition
// is injected into jobs at claim time as config.connector. The definition is DATA, never code — the
// runner re-validates it before executing and enforces the definition's host allowlist.
model Connector {
  id          String    @id @default(cuid())
  key         String    @unique // systemKey — always "custom-…" so it can never shadow a built-in
  name        String
  kind        String // http | browser
  status      String    @default("draft") // draft | published | archived
  definition  Json
  secretNames String[] // logical secret names the definition references (wired per client in Delinea)
  notes       String?
  createdBy   String? // actor label snapshot ("user:jane@core.tech"), never a joinable FK
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

// (~200 clients, read whole and rendered whole), never queried across runs, and the two kinds have
// nothing in common to normalise. See lib/audits/m365-audit.ts for the row shapes.
//
// Runs take minutes — a Delinea resolve plus several Graph reads per tenant — so this cannot happen
// inside a page load: the sweep writes here and /audits reads the last finished run instantly.
model FleetAudit {
  id         String    @id @default(cuid())
  kind       String // "permissions" | "leaked_seats"
  status     String    @default("running") // running | done | failed
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  startedBy  String? // actor label snapshot ("user:jane@core.tech"), never a joinable FK
  scanned    Int       @default(0) // clients completed so far — drives the progress line
  total      Int       @default(0) // clients this run intends to visit
  findings   Json? // AuditRow[] | LeakRow[] (by kind)
  error      String?

  // "the latest run of this kind" is the only query this table serves.
  @@index([kind, startedAt])
}

// A run of the automated M365 app-registration setup — one client ("client" scope) or the fleet
// ("fleet" scope). Mirrors FleetAudit's start/track/read shape; per-client detail lives in
// M365SetupRunClient. Takes minutes per client, so the work runs detached and the UI polls this row.
model M365SetupRun {
  id         String               @id @default(cuid())
  scope      String // "client" | "fleet"
  status     String               @default("running") // running | done | failed
  dryRun     Boolean              @default(false) // fleet eligibility preview — no device-code/provision
  startedAt  DateTime             @default(now())
  finishedAt DateTime?
  startedBy  String? // actor label snapshot ("user:jane@core.tech")
  total      Int                  @default(0) // clients this run intends to visit
  completed  Int                  @default(0) // clients reaching any terminal per-client state
  succeeded  Int                  @default(0)
  skipped    Int                  @default(0)
  failed     Int                  @default(0)
  error      String?
  clients    M365SetupRunClient[]

  @@index([scope, startedAt]) // "the latest run of this scope"
}

// One client's outcome within a run. Its stage/warnings mirror SetupResult so the UI can show exactly
// where it stopped and why (incl. a non-automatable-MFA browser warning).
model M365SetupRunClient {
  id              String       @id @default(cuid())
  run             M365SetupRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId           String
  clientId        String
  slug            String
  name            String
  status          String       @default("pending") // pending | running | done | skipped | failed
  stage           String? // SetupResult.stage
  appId           String?
  wroteCreds      Boolean?
  verified        Boolean?
  skipReason      String? // e.g. "no m365-global-admin secret"
  error           String?
  warnings        String[] // SetupResult.browserWarnings (e.g. "WARN MFA push not automatable")
  userCode        String? // device user-code, surfaced while running for a manual fallback
  verificationUri String?
  log             String[] // SetupResult.actions — the full step/error trail, for the UI's expandable run log
  updatedAt       DateTime     @updatedAt

  @@index([runId])
}

// A run of the automated Google Workspace setup (service account + domain-wide delegation) —
// client scope only, no fleet mode. Mirrors M365SetupRun's start/track/read shape; per-client
// detail lives in GoogleSetupRunClient.
model GoogleSetupRun {
  id         String                 @id @default(cuid())
  scope      String // "client:<clientId>" (no fleet mode)
  status     String                 @default("running") // running | done | needs_action | failed
  startedAt  DateTime               @default(now())
  finishedAt DateTime?
  startedBy  String?
  total      Int                    @default(0)
  completed  Int                    @default(0)
  succeeded  Int                    @default(0)
  skipped    Int                    @default(0)
  failed     Int                    @default(0)
  error      String?
  clients    GoogleSetupRunClient[]

  @@index([scope, startedAt])
}

// One client's outcome within a GoogleSetupRun. Its stage/warnings mirror GoogleSetupResult so the
// UI can show exactly where it stopped and why (incl. a manual-DWD fallback card).
model GoogleSetupRunClient {
  id         String         @id @default(cuid())
  run        GoogleSetupRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId      String
  clientId   String
  slug       String
  name       String
  status     String         @default("pending") // pending | running | done | needs_action | skipped | failed
  stage      String? // GoogleSetupResult.stage
  saEmail    String?
  saClientId String? // numeric uniqueId — the DWD grant target
  verified   Boolean?
  wroteCreds Boolean?
  skipReason String?
  error      String?
  warnings   String[]
  userAction Json? // manual-DWD fallback card: { kind:"dwd", clientId, scopes } — non-secret only
  log        String[]
  updatedAt  DateTime       @updatedAt

  @@index([runId])
}

// PROVENANCE: which Delinea credential was used to SET UP a given module for a client — so when the
// vendor's permissions need changing later, an operator knows exactly which secret (and folder) to go
// edit, without spelunking the wiring. ONE current row per (client, module), upserted on each setup.
// Independent of the Secret wiring row (which is keyed by the logical secret NAME); this adds the
// module dimension + a stable "who/when/where it was set up" record. Additive — touches no existing data.
model ModuleSetupCredential {
  id              String   @id @default(cuid())
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId        String
  moduleKey       String // the system/module the credential set up (e.g. "spanning", "adobe", "m365")
  delineaSecretId String // the Delinea externalId used/vaulted for this module's setup
  delineaFolderId String? // the folder it was written to (null when unknown / an overwrite in place)
  setBy           String? // userId of the operator who ran the setup (null for a system/agent caller)
  setAt           DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clientId, moduleKey])
  @@index([clientId])
}

// Generalized async setup run, keyed by moduleKey — the vendor-agnostic successor to the bespoke
// M365SetupRun/GoogleSetupRun pairs. The per-vendor BROWSER auto-provisioning flows (built in later
// PRs) reuse this one run/row/sweep instead of a new table pair each. Vendor-specific fields ride in
// the per-client `detail` JSON so no schema change is needed per vendor.
model ModuleSetupRun {
  id          String                 @id @default(cuid())
  moduleKey   String // e.g. "spanning", "adobe", "mimecast"
  scope       String // "client:<clientId>" | "fleet"
  status      String                 @default("running") // running | done | needs_action | failed
  startedAt   DateTime               @default(now())
  finishedAt  DateTime?
  startedBy   String? // actor label snapshot ("user:jane@core.tech")
  startedById String? // FK to the initiating user, for automation-on-behalf audit attribution
  total       Int                    @default(0)
  completed   Int                    @default(0)
  succeeded   Int                    @default(0)
  skipped     Int                    @default(0)
  failed      Int                    @default(0)
  error       String?
  clients     ModuleSetupRunClient[]

  @@index([moduleKey, scope, startedAt]) // "the latest run of this module+scope"
}

// One client's outcome within a ModuleSetupRun. `detail` carries the vendor-specific result (e.g.
// { appId } for Mimecast, { tokenId } for a portal) so the model stays vendor-agnostic.
model ModuleSetupRunClient {
  id        String         @id @default(cuid())
  run       ModuleSetupRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     String
  clientId  String
  slug      String
  name      String
  status    String         @default("pending") // pending | running | done | needs_action | skipped | failed
  stage     String?
  error     String?
  skipReason String?
  warnings  String[]
  detail    Json? // vendor-specific, non-secret (e.g. { appId } / { tokenId } / { userAction })
  log       String[]
  updatedAt DateTime       @updatedAt

  @@index([runId])
}
