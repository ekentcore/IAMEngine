# web/.env is generated by `npm run env:sync` from the repo-root env.env.
# These are the variables it writes (shown here as a reference / fallback).

# Database (assembled from POSTGRES_* in env.env)
DATABASE_URL="postgresql://user:password@localhost:5432/automationUM?schema=public"

# ServiceNow (client roster source — see lib/servicenow)
SN_INSTANCE_URL="https://yourinstance.service-now.com"
SN_USER="api_user"
SN_PASSWORD="..."

# Shared with the runner (Phase 3 — see docs/RUNNER_PROTOCOL.md)
APP_URL="https://iam-engine.internal"
DELINEA_BASE_URL="https://coretelligent.secretservercloud.com"
# Interim runner-API auth (until mTLS). When set, /api/agents + /api/jobs require
# `Authorization: Bearer $RUNNER_API_TOKEN`; the runner sends it. Leave unset only for
# local dev. ENROLLMENT_TOKEN additionally gates POST /api/agents (x-enrollment-token).
RUNNER_API_TOKEN=""
ENROLLMENT_TOKEN=""
